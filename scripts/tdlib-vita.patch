new file mode 100644
--- /dev/null
+++ b/tdutils/td/utils/VitaDnsTrace.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cerrno>
+
+namespace td {
+#if defined(__vita__) || defined(VITAGRAM_TD_DNS_TEST)
+// Numeric diagnostics only: names, addresses and response bodies stay inside TDLib.
+extern "C" uint64_t vitagram_dns_begin(unsigned method, unsigned family, unsigned resolver) __attribute__((weak));
+extern "C" void vitagram_dns_end(uint64_t id, unsigned method, int code, int detail, int64_t elapsed_us) __attribute__((weak));
+extern "C" void vitagram_dns_event(uint64_t id, unsigned phase, int code, int detail, int64_t aux) __attribute__((weak));
+inline void vita_dns_event(uint64_t id, unsigned phase, int code, int detail = 0, int64_t aux = 0) {
+  const int saved_errno = errno;
+  if (vitagram_dns_event) vitagram_dns_event(id, phase, code, detail, aux);
+  errno = saved_errno;
+}
+class VitaDnsTrace {
+ public:
+  void start(unsigned method, bool prefer_ipv6, bool resolver = false) {
+    method_ = method;
+    if (vitagram_dns_begin && vitagram_dns_end) {
+      begin_ = std::chrono::steady_clock::now();
+      id_ = vitagram_dns_begin(method, prefer_ipv6 ? 6 : 4, resolver);
+    }
+  }
+  void finish(int code, int detail) {
+    if (!id_) return;
+    auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - begin_).count();
+    vitagram_dns_end(id_, method_, code, detail, elapsed);
+    id_ = 0;
+  }
+  void event(unsigned phase, int code, int detail = 0, int64_t aux = 0) {
+    if (id_) vita_dns_event(id_, phase, code, detail, aux);
+  }
+  ~VitaDnsTrace() { finish(-1, 0); }
+  VitaDnsTrace() = default;
+  VitaDnsTrace(const VitaDnsTrace &) = delete;
+  VitaDnsTrace &operator=(const VitaDnsTrace &) = delete;
+ private:
+  uint64_t id_ = 0;
+  unsigned method_ = 0;
+  std::chrono::steady_clock::time_point begin_;
+};
+#else
+inline void vita_dns_event(uint64_t, unsigned, int, int = 0, int64_t = 0) {}
+class VitaDnsTrace {
+ public:
+  void start(unsigned, bool, bool = false) {}
+  void finish(int, int) {}
+  void event(unsigned, int, int = 0, int64_t = 0) {}
+};
+#endif
+}  // namespace td
